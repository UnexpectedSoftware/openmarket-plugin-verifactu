{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "commonjs",
    "target": "es2023",
    "moduleResolution": "node",
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["index.js", "src/**/*.js", "test/**/*.js", "scripts/**/*.js"]
}
